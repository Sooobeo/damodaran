APP_HOST=127.0.0.1
APP_PORT=3000
DATA_DIR=./data
TRANSLATION_PROVIDER=argos
# 선택형: finetuned(학습·평가 및 등록을 마친 로컬 모델), openai(외부 유료 API)
OPENAI_API_KEY=
TRANSLATION_MODEL=
MAX_SOURCE_CHARS_PER_JOB=20000
MAX_SOURCE_CHARS_PER_DAY=100000
MAX_DOWNLOAD_BYTES=52428800
MAX_PDF_PAGES=1000
WORKER_CONCURRENCY=1
# 실제 NYU 파일의 www -> people -> pages 리디렉션에 필요
EXTRA_SOURCE_HOSTS=people.stern.nyu.edu
