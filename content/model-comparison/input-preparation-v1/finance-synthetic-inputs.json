      "document": {
        "resourceId": "fixture-ip1-f05",
        "sourceVersionId": "fixture-ip1-f05-v1",
        "title": "Quarterly lending worksheet",
        "titleKo": "",
        "format": "html",
        "extractorVersion": "structured-v2-compatible-fixture",
        "blocks": [
          {
            "id": "fixture-ip1-f05-h",
            "order": 0,
            "kind": "heading",
            "text": "Revision of the annual lending rate",
            "metadata": {
              "schemaVersion": 1,
              "level": 2,
              "links": []
            },
            "textSha256": "79f17f342770a610d702d5d22cd68f0eea05b737826f59eeb9065b1447ad012e"
          },
          {
            "id": "fixture-ip1-f05-b",
            "order": 1,
            "kind": "paragraph",
            "text": "The worksheet separates an annual lending rate from the fee charged for preparing a loan. The starting rate for the revision is 4%.",
            "metadata": {
              "schemaVersion": 1,
              "links": []
            },
            "textSha256": "52bf16c2aea059f01ffdd6f022097b0c026f4291ee79bc9e0f5c3f2bda492867"
          },
          {
            "id": "fixture-ip1-f05-t",
            "order": 2,
            "kind": "paragraph",
            "text": "The credit committee increased the annual lending rate by 2 percentage points. The revision describes the size of the change, not a replacement label for the original rate. The preparation fee remains unchanged. Record the new rate only after applying the stated change to the starting rate; do not add the preparation fee to that calculation.",
            "metadata": {
              "schemaVersion": 1,
              "links": []
            },
            "textSha256": "8c24011f5151f36d969fd416fe7167cf0a2625ad7476589fbb37f7ed7e1c081b"
          },
          {
            "id": "fixture-ip1-f05-a",
            "order": 3,
            "kind": "paragraph",
            "text": "The preparation fee appears in a separate monetary column and is not expressed as an annual rate.",
            "metadata": {
              "schemaVersion": 1,
              "links": []
            },
            "textSha256": "5106547abdd96e88cfceff41bb59d25cf26f2df16fe660358f89670c048faa40"
          }
        ]
      },
      "targetBlockId": "fixture-ip1-f05-t"
    },
